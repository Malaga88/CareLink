PORT=4000

# Same variable name as your AMS backend. Copy your connection string from that project's .env
# (or from MongoDB Atlas > Connect) and CHANGE THE DATABASE NAME in the path to "carelink",
# e.g. mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/carelink?retryWrites=true&w=majority
# This keeps CareLink data separate from your AMS data on the same cluster.
MONGO_URI=mongodb://localhost:27017/carelink

# Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated frontend origins allowed by CORS. Not needed when the API serves the frontend itself.
CLIENT_ORIGIN=http://127.0.0.1:5500

# Serve ../frontend from this server (same origin, simplest deployment). Set to 0 to run API-only.
SERVE_FRONTEND=1

# Hours offset from UTC used to decide what "today" is (Nigeria = 1)
TZ_OFFSET_HOURS=1

# Set to 1 when deployed behind a reverse proxy (Render, Railway, Nginx...)
# TRUST_PROXY=1

# Used only by `npm run seed`: password given to every demo account (min 8 characters)
SEED_PASSWORD=
