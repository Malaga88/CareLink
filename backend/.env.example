PORT=4000

# MongoDB connection string. Use your Atlas string and put the database name "carelink" in the path:
#   mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/carelink?retryWrites=true&w=majority
# NEVER put the real value in this file. This file is committed to Git; put real values only in .env (which is gitignored).
MONGO_URI=mongodb://localhost:27017/carelink

# Required (32+ characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated frontend origins allowed by CORS. Not needed when this server also serves the frontend.
CLIENT_ORIGIN=http://127.0.0.1:5500

# Serve ../frontend from this server (same origin, simplest deployment). Set to 0 to run API-only.
SERVE_FRONTEND=1

# Hours ahead of UTC that clinic times use (Nigeria = 1). Decides what "today" and appointment times mean.
TZ_OFFSET_HOURS=1

# Video consultations open a meeting room on this Jitsi server. Self-host one for real patient use.
VIDEO_BASE_URL=https://meet.jit.si

# Set to 1 when deployed behind a reverse proxy (Render, Railway, Nginx...)
# TRUST_PROXY=1
